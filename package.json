{
  "name": "ai-client",
  "version": "0.4.0",
  "description": "One window for all your Claude Code sessions: live terminals, needs-input notifications, usage and cost, git explorer.",
  "license": "MIT",
  "author": "91kr7",
  "homepage": "https://github.com/91kr7/vexel-for-claude#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/91kr7/vexel-for-claude.git"
  },
  "bugs": {
    "url": "https://github.com/91kr7/vexel-for-claude/issues"
  },
  "keywords": ["claude-code", "electron", "terminal", "xterm", "developer-tools", "linux"],
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"AI_CLIENT_VITE_DEV_PORT=5173 tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production PORT=4001 tsx src/server/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:desktop": "E2E_DESKTOP=1 playwright test",
    "build:desktop": "tsc -b tsconfig.desktop.build.json",
    "desktop": "npm run --silent build:desktop && electron --no-sandbox .",
    "desktop:install": "npm run --silent build && npm run --silent build:desktop && tsx src/desktop/install-menu-entry.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@jellybrick/dbus-next": "^0.11.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.3",
    "fastify": "^5.12.8",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
